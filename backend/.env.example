# Primary chat provider: Gemini. Ollama remains selectable with LLM_PROVIDER=ollama.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini
OLLAMA_MODEL=llama3.2:latest

# ElevenLabs speech. Set each voice ID from the authenticated voice list;
# leave IDs blank until choosing real voices in the Companion Designer.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v4_turbo
TTS_PROVIDER=elevenlabs
TTS_FALLBACK_PROVIDER=piper
ELEVENLABS_VOICE_ID_MOSS=
ELEVENLABS_VOICE_ID_NOVA=
ELEVENLABS_VOICE_ID_ECHO=
ELEVENLABS_VOICE_ID_ZEN=
